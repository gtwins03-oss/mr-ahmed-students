{
  "name": "mr-ahmed-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arabic RTL React front-end for the Student Management & Notification System",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "assets:gen": "node scripts/generate-assets.mjs && npx --yes @capacitor/assets@3 generate --android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/browser": "6.0.6",
    "@capacitor/core": "6.2.2",
    "@capacitor/preferences": "6.0.4",
    "@tanstack/query-sync-storage-persister": "^5.62.0",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-query-persist-client": "^5.62.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
