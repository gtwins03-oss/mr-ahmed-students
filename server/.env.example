# ملف إعدادات الخادم — انسخه إلى ‎.env‎ ثم عدّل القيم
# انسخ: cp .env.example .env

# ── قاعدة البيانات ─────────────────────────────────────────────────────
# التطوير المحلي: ملف SQLite واحد داخل server/data — لا يحتاج أي إعداد
DATABASE_URL="file:../data/tutor.db"

# للتحويل إلى PostgreSQL / Supabase: شغّل `npm run db:use-postgres`
# ثم فعّل السطر التالي بدلاً من السطر السابق (كل الجداول متوافقة مع المزوّدَين)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ── الخادم ─────────────────────────────────────────────────────────────
# المنفذ الذي يعمل عليه الـ API
PORT=4000

# ── المصادقة (JWT) ─────────────────────────────────────────────────────
# المفتاح السرّي لتوقيع رموز الدخول — غيّره إلى نص عشوائي طويل قبل النشر
JWT_SECRET="change-me-to-a-long-random-string"

# مدة صلاحية رمز الدخول قبل انتهائه (مثال: 30d أو 12h)
JWT_EXPIRES_IN="30d"

# ── حساب المالك (يُنشأ تلقائياً عند تشغيل db:seed) ─────────────────────
# اسم مستخدم المالك — صاحب الصلاحيات الكاملة (سجل النشاط وإدارة المستخدمين).
# لو كان في قاعدة البيانات حساب بالاسم القديم، فإن db:seed يعيد تسميته إلى هذا
# الاسم مع الاحتفاظ بنفس المعرّف حتى يبقى سجل النشاط مرتبطاً به.
OWNER_USERNAME="MrAhmed"

# كلمة مرور المالك.
#
# ⚠️ هذا الملف يُرفع إلى Git — لا تضع فيه كلمة مرور حقيقية أبداً. اكتب كلمتك
#    في server/.env وحده (وهو مستبعَد من Git).
#
# لو تركت هذا السطر فارغاً، فإن db:seed يولّد كلمة مرور عشوائية قوية ويطبعها
# مرة واحدة في الطرفية. لا توجد كلمة مرور افتراضية مكتوبة في الكود عن قصد:
# كلمة معروفة + خادم منشور على الإنترنت = أي شخص يدخل كمالك.
OWNER_PASSWORD=""

# ── CORS ───────────────────────────────────────────────────────────────
# المصادر المسموح لها بالاتصال بالـ API، مفصولة بفاصلة
# (واجهة التطوير Vite + تطبيق الأندرويد داخل WebView)
CORS_ORIGINS="http://localhost:5173,capacitor://localhost,http://localhost"
